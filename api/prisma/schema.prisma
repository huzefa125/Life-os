// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model User {
   id        String   @id @default(uuid())
   email     String   @unique
   name      String
   password  String
   CreatedAt DateTime @default(now())
   UpdateAt  DateTime @updatedAt

   Objects    Object[]
   relations  Relation[]
   favorites  Favorite[]
   activities Activity[]
}

model Object {
  id         String    @id @default(uuid())
  userId     String
  type       String
  title      String
  properties Json?
  tags       String[]  @default([])
  status     String    @default("active") // "active" | "archived" | "trash"
  archivedAt DateTime?
  deletedAt  DateTime?

  // Set only on type:"collection_record" rows — the owning type:"collection"
  // Object. A real column (not a properties key) so record lists paginate and
  // filter off an index instead of scanning JSON.
  collectionId String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  collection Object?    @relation("CollectionRecords", fields: [collectionId], references: [id], onDelete: Cascade)
  records    Object[]   @relation("CollectionRecords")

  sourceRelations Relation[] @relation("SourceRelations")
  targetRelations Relation[] @relation("TargetRelations")
  favorites       Favorite[]
  activities      Activity[]

  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([userId, status])
  @@index([userId, collectionId, status, createdAt])
}

model Relation {
  id        String   @id @default(uuid())
  userId    String

  sourceId  String
  targetId  String

  type      String

  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  source Object @relation("SourceRelations", fields: [sourceId], references: [id], onDelete: Cascade)
  target Object @relation("TargetRelations", fields: [targetId], references: [id], onDelete: Cascade)

  @@index([sourceId])
  @@index([targetId])
  @@index([userId])
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  objectId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  object Object @relation(fields: [objectId], references: [id], onDelete: Cascade)

  @@unique([userId, objectId])
  @@index([userId])
  @@index([objectId])
}

model Activity {
  id        String   @id @default(uuid())
  userId    String
  objectId  String
  action    String
  details   Json?
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  object Object @relation(fields: [objectId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([objectId])
  @@index([createdAt])
}